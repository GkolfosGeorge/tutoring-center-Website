generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_SITE")
}

model User {
  id             String          @id @default(cuid())
  name           String
  username       String          @unique
  password       String
  role           String          @default("STUDENT")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
}

model StudentProfile {
  id                      String              @id @default(cuid())
  userId                  String              @unique
  classYear               String
  direction               String?
  schoolYear              String?
  firstName               String?
  lastName                String?
  phone                   String?
  email                   String?
  fatherName              String?
  fatherPhone             String?
  motherName              String?
  motherPhone             String?
  primaryContact          String? // "FATHER" | "MOTHER" — which phone is the main emergency contact
  parentEmail             String?
  address                 String?
  comments                String?
  afm                     String?
  doy                     String?
  tuitionBalance          Float               @default(0)
  lastSeenAnnouncementsAt DateTime?
  absences                Absence[]
  examGrades              ExamGrade[]
  grades                  Grade[]
  payments                Payment[]
  receipts                Receipt[]
  groups                  StudentGroup[]
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments             SubjectEnrollment[]
}

model SubjectEnrollment {
  id              String          @id @default(cuid())
  studentId       String
  subject         String
  costPerHour     Float           @default(0)
  durationMinutes Int             @default(60)
  createdAt       DateTime        @default(now())
  sessionStatuses SessionStatus[]
  student         StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slots           WeeklySlot[]
}

model WeeklySlot {
  id           String            @id @default(cuid())
  enrollmentId String
  dayOfWeek    Int
  startTime    String
  endTime      String
  groupId      String?
  enrollment   SubjectEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  group        Group?            @relation(fields: [groupId], references: [id])
}

model SessionStatus {
  id           String            @id @default(cuid())
  enrollmentId String
  date         DateTime
  held         Boolean           @default(true)
  createdAt    DateTime          @default(now())
  enrollment   SubjectEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
}

model Grade {
  id        String         @id @default(cuid())
  studentId String
  subject   String
  examType  String
  score     Float
  maxScore  Float          @default(20)
  date      DateTime
  notes     String?
  createdAt DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Absence {
  id        String         @id @default(cuid())
  studentId String
  subject   String
  date      DateTime
  justified Boolean        @default(false)
  notes     String?
  createdAt DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String         @id @default(cuid())
  studentId     String
  amount        Float
  date          DateTime
  description   String
  paymentMethod String?
  isPaid        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Receipt {
  id         String         @id @default(cuid())
  studentId  String
  amount     Float
  date       DateTime
  fileName   String
  filePath   String
  fileSize   Int
  uploadedAt DateTime       @default(now())
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model CourseFile {
  id         String   @id @default(cuid())
  title      String
  subject    String
  category   String? // "Σημειώσεις Μαθήματος" | "Λύσεις Ασκήσεων" | "Διαγωνίσματα" | "Τυπολόγιο" | "Επανάληψη" | "Θεωρία"
  classYear  String?
  isFlipbook Boolean  @default(false) // view-only in-browser flip book (no direct download link)
  fileName   String
  filePath   String
  fileSize   Int
  uploadedAt DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Teacher {
  id       String  @id @default(cuid())
  name     String
  subject  String
  bio      String?
  photoUrl String?
  order    Int     @default(0)
}

model SuccessStory {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  academicYear    Int // ακαδημαϊκό/εισαγωγικό έτος
  direction       String // "Θετική" | "Οικονομίας/Πληροφορικής" | "Θεωρητική"
  directionTrack  String? // "Μαθηματικά" | "Βιολογία" — only when direction = "Θετική"
  university      String // Ίδρυμα εισαγωγής
  department      String? // Τμήμα εισαγωγής
  grades          String? // JSON: [{"subject":"Μαθηματικά","score":18.5}, ...]
  generalScore    Float? // Γενικός Βαθμός Πρόσβασης (0-20)
  admissionPoints Float? // Μόρια Εισαγωγής
  photoUrl        String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model Group {
  id                 String              @id @default(cuid())
  name               String              @unique
  classYear          String?
  createdAt          DateTime            @default(now())
  announcementGroups AnnouncementGroup[]
  examGroups         ExamGroup[]
  members            StudentGroup[]
  weeklySlots        WeeklySlot[]
}

model StudentGroup {
  id        String         @id @default(cuid())
  studentId String
  groupId   String
  subjects  String? // JSON: ["Μαθηματικά","Φυσική"] – null means all subjects
  createdAt DateTime       @default(now())
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId])
}

model Exam {
  id             String      @id @default(cuid())
  title          String
  description    String?
  subject        String
  classYear      String
  examType       String // "EXAM" | "TEST" | "QUESTIONS"
  scale          Int         @default(100)
  examDate       String?
  examTime       String?
  ekfoniseisPath String?
  lyseisPath     String?
  createdAt      DateTime    @default(now())
  grades         ExamGrade[]
  groups         ExamGroup[]
}

model ExamGroup {
  id      String @id @default(cuid())
  examId  String
  groupId String
  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([examId, groupId])
}

model ExamGrade {
  id          String         @id @default(cuid())
  examId      String
  studentId   String
  theme1      Float?
  theme2      Float?
  theme3      Float?
  theme4      Float?
  totalScore  Float?
  absent      Boolean        @default(false)
  writtenDate String?
  updatedAt   DateTime       @updatedAt
  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model ClassEvent {
  id           String   @id @default(cuid())
  groupName    String
  subject      String
  date         DateTime
  startTime    String
  endTime      String
  classroom    String? // "1" | "2" | "3" | "4"
  recurrenceId String?
  notes        String?
  createdAt    DateTime @default(now())
}

model Announcement {
  id        String              @id @default(cuid())
  message   String
  createdAt DateTime            @default(now())
  groups    AnnouncementGroup[]
}

model AnnouncementGroup {
  id             String       @id @default(cuid())
  announcementId String
  groupId        String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([announcementId, groupId])
}
