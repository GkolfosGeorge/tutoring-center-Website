# Postgres connection string from your provider (Neon/Supabase/Railway), e.g.:
# postgresql://user:password@host:5432/dbname?sslmode=require
# NOTE: named DATABASE_URL_SITE (not DATABASE_URL) to avoid clashing with
# any DATABASE_URL already set at the OS/user environment level.
DATABASE_URL_SITE=
NEXTAUTH_URL="http://localhost:3000"
# Generate a real random value for this, e.g.: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Optional: fix the seed admin/secretary passwords instead of letting
# `npx prisma db seed` generate + print random ones on first run.
SEED_ADMIN_PASSWORD=

# Email (SMTP) — needed for the "Email Γονέα" button in the Σύνοψη tab
# Example for Gmail with App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your-email@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
