/prisma/dev.db-journal
*.db
*.db-journal

# uploaded files (exam papers, receipts, course files — real personal/financial data)
/public/uploads/

# local logs
*.log
dev.log

# Claude Code local settings (machine-specific, not shared)
/.claude/settings.local.json

# personal notes (credentials / how-to notes — not for the repo)
